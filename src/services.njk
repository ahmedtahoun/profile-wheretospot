---
pagination:
  data: pages.langs
  size: 1
  alias: item
permalink: "{{ '/ar' if item.lang == 'ar' }}/services/"
---
{%- extends "base.njk" -%}
{%- set lang = item.lang -%}
{%- set path = "/services/" -%}
{%- set navSection = "services" -%}
{%- set pageTitle = "nav_services" | t(lang) -%}
{%- set pageDesc = "services_index_sub" | t(lang) -%}
{% block content %}
<section class="page-head">
  <div class="container">
    <p class="kicker">{{ "services_kicker" | t(lang) }}</p>
    <h1 class="h1">{{ "services_title" | t(lang) }}</h1>
    <p class="lead readable">{{ "services_index_sub" | t(lang) }}</p>
  </div>
</section>
<section class="section section-tight">
  <div class="container">
    <ul class="svc-list">
      {%- for c in categories %}
      {%- set s = services | findBySlug(c.slug) %}
      {%- set n = (projects | byCategory(c.slug)).length %}
      <li class="svc-row">
        <span class="svc-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
        <div>
          <h2 class="h3"><a href="{{ ('/services/' + c.slug + '/') | lp(lang) }}">{{ c | f("name", lang) }}</a></h2>
          <p class="svc-tags">{{ (s.tags_ar if lang == 'ar' else s.tags_en) | join(" · ") }}</p>
          <p class="muted">{{ s | f("summary", lang) }}</p>
        </div>
        <a class="link-arrow" href="{{ ('/work/' + c.slug + '/') | lp(lang) }}">{{ "projects_count" | t(lang, {n: n}) }}</a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{% include "partials/cta.njk" %}
{% endblock %}
