---
pagination:
  data: pages.langs
  size: 1
  alias: item
permalink: "{{ '/ar/' if item.lang == 'ar' else '/' }}"
eleventyExcludeFromCollections: false
---
{%- extends "base.njk" -%}
{%- set lang = item.lang -%}
{%- set path = "/" -%}
{%- set pageTitle = "" -%}
{%- set pageDesc = "hero_sub" | t(lang) -%}
{%- set bodyClass = "page-home" -%}
{%- set rot = "hero_rot" | t(lang) -%}
{% block jsonld %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ site.name | dump | safe }},"url":{{ (site.url + "/") | dump | safe }},"logo":{{ (site.url + "/images/logo.png") | dump | safe }},"email":{{ site.email | dump | safe }},"telephone":{{ site.phone_e164 | dump | safe }},"sameAs":[{{ site.main_site | dump | safe }}{% for so in site.socials %},{{ so.url | dump | safe }}{% endfor %}]}</script>
{% endblock %}
{% block content %}
<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-in">
    <p class="eyebrow-pill"><span class="dot" aria-hidden="true"></span>{{ "hero_eyebrow" | t(lang) }}</p>
    <h1 class="hero-title">
      <span class="hero-line">{{ "hero_line1" | t(lang) }}</span>
      <span class="rot" aria-hidden="true">
        <span class="rot-spacer">{{ rot | last }}</span>
        {%- for w in rot %}<span class="rot-word{% if loop.first %} rot-first{% endif %}" style="--i:{{ loop.index0 }}">{{ w }}</span>{% endfor %}
      </span>
      <span class="sr-only">{{ rot | first }}</span>
    </h1>
    <p class="hero-sub readable">{{ "hero_sub" | t(lang) }}</p>
    <div class="hero-ctas">
      <a class="btn btn-primary btn-lg" href="{{ '/work/' | lp(lang) }}">{{ "hero_cta1" | t(lang) }} <span aria-hidden="true">{{ "←" if lang == "ar" else "→" }}</span></a>
      <a class="btn btn-ghost btn-lg" href="{{ '/contact/' | lp(lang) }}">{{ "hero_cta2" | t(lang) }}</a>
    </div>
    <div class="trusted">
      <span class="trusted-label">{{ "trusted_by" | t(lang) }}</span>
      <ul class="trusted-logos">
        {%- for c in clients.strip %}<li><img src="/{{ c.logo }}" alt="{{ c.name or '' }}" width="96" height="22" loading="lazy"></li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-row"><div class="ticker-track">
    {%- for r in [1, 2] %}<span class="ticker-set">{% for c in categories %}<span>{{ c | f("name", lang) }}</span><span class="ticker-star">✦</span>{% endfor %}</span>{% endfor %}
  </div></div>
</div>

<section class="section">
  <div class="container">
    <ul class="stats">
      {%- for s in stats %}
      <li class="stat"><span class="stat-num" data-count="{{ s.value }}">{{ s.value }}{{ s.suffix }}</span><span class="stat-label">{{ s | f("label", lang) }}</span></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="h-services">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="kicker">{{ "services_kicker" | t(lang) }}</p>
        <h2 class="h2" id="h-services">{{ "services_title" | t(lang) }}</h2>
      </div>
      <a class="link-arrow" href="{{ '/services/' | lp(lang) }}">{{ "see_all_services" | t(lang) }}</a>
    </div>
    <ul class="svc-grid">
      {%- for c in categories %}
      {%- set s = services | findBySlug(c.slug) %}
      <li>
        <a class="svc-card" href="{{ ('/services/' + c.slug + '/') | lp(lang) }}">
          <span class="svc-num">{{ "0" if loop.index < 10 }}{{ loop.index }}</span>
          <span class="svc-name">{{ c | f("name", lang) }}</span>
          <span class="svc-tags">{{ (s.tags_ar if lang == 'ar' else s.tags_en) | join(" · ") }}</span>
          <span class="svc-arrow" aria-hidden="true">{{ "↖" if lang == "ar" else "↗" }}</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" aria-labelledby="h-featured">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="kicker">{{ "work_kicker" | t(lang) }}</p>
        <h2 class="h2" id="h-featured">{{ "work_title" | t(lang) }}</h2>
      </div>
      <a class="link-arrow" href="{{ '/work/' | lp(lang) }}">{{ "see_all_work" | t(lang) }}</a>
    </div>
    <div class="pgrid">
      {%- asyncEach p in (projects | featured | limit(6)) %}{% include "partials/project-card.njk" %}{% endeach %}
    </div>
  </div>
</section>

<section class="section" aria-labelledby="h-reel">
  <div class="container">
    <p class="kicker">{{ "reel_kicker" | t(lang) }}</p>
    <h2 class="h2" id="h-reel">{{ "reel_title" | t(lang) }}</h2>
    <div class="video-frame" data-yt="{{ site.showreel_id }}" data-title="{{ 'reel_kicker' | t(lang) }}">
      <a class="video-facade" href="https://www.youtube.com/watch?v={{ site.showreel_id }}" target="_blank" rel="noopener">
        <img src="https://i.ytimg.com/vi/{{ site.showreel_id }}/hqdefault.jpg" alt="{{ 'reel_kicker' | t(lang) }}" width="480" height="360" loading="lazy">
        <span class="play" aria-hidden="true">▶</span>
        <span class="sr-only">{{ "watch" | t(lang) }}</span>
      </a>
    </div>
  </div>
</section>

<section class="section logos-band" aria-labelledby="h-clients">
  <div class="container"><h2 class="h3" id="h-clients">{{ "clients_title" | t(lang) }}</h2></div>
  <div class="marquee" aria-hidden="true"><div class="marquee-track">
    {%- for r in [1, 2] %}<span class="marquee-set">{% for c in clients.wall %}<img src="/{{ c.logo }}" alt="" width="120" height="60" loading="lazy">{% endfor %}</span>{% endfor %}
  </div></div>
</section>

<section class="section" aria-labelledby="h-testi">
  <div class="container">
    <h2 class="h2" id="h-testi">{{ "testi_title" | t(lang) }}</h2>
    <ul class="testi-grid">
      {%- for tm in testimonials | limit(3) %}
      <li class="testi">
        <p class="stars" aria-hidden="true">★★★★★</p>
        <blockquote><p>“{{ tm | f("quote", lang) }}”</p></blockquote>
        <p class="testi-who"><span class="avatar" aria-hidden="true">{{ tm.initial }}</span><span><b>{{ tm.name_ar if lang == 'ar' else tm.name }}</b><span class="muted">{{ tm | f("role", lang) }}</span></span></p>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

{% include "partials/cta.njk" %}
{% endblock %}
