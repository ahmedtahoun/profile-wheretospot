// Cloudflare: profile.wheretospot.com as the "profile" Worker.
// Build: `npm run build` (Eleventy → _site). Deploy: `npx wrangler deploy`.
// Push to main → GitHub Actions (.github/workflows/deploy.yml) runs both.
// The Worker (worker/index.js) answers only /api/* and /leads.php; everything else is a static file from _site.
// Secrets (never in git): ADMIN_PASSWORD, ANTHROPIC_API_KEY — set with `npx wrangler secret put NAME`.
{
  "name": "profile",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "profile.wheretospot.com", "custom_domain": true }],
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/leads.php"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "profile-leads", "database_id": "b3fb42b2-019e-460f-83fd-0e08a5660577" }
  ]
}
